# Stringa di connessione Neon (quella "pooled", con -pooler nell'host)
DATABASE_URL=postgresql://utente:password@host-pooler.neon.tech/neondb?sslmode=require

# Chiave per firmare la sessione: almeno 32 caratteri casuali (openssl rand -base64 48)
AUTH_SECRET=

# Facoltative: credenziali OAuth di Google Cloud (tipo "Applicazione web"); senza, resta solo email+password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facoltativi
# URL pubblico dell'app (default: quello della richiesta), es. https://duofin.vercel.app
APP_URL=
# Se impostato, possono entrare solo queste email (separate da virgola)
ALLOWED_EMAILS=

# Registrazioni chiuse di default; metti 1 per riaprirle
SIGNUP_OPEN=
# Hash scrypt (formato s1$sale$hash, vedi lib/password.ts) delle due password della cancellazione totale
WIPE_UNLOCK_HASH=
WIPE_CONFIRM_HASH=
